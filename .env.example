# =============================================================================
# Hybrid RAG Knowledge Platform - Root Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env file to version control!
# Generate secrets with: openssl rand -base64 48
# See: knowledge_service/docs/06_deployment/security_env_setup_guide.md
# =============================================================================

# =============================================================================
# SECURITY: Required Credentials (MUST change before deployment)
# =============================================================================

# JWT Secret - REQUIRED (min 32 chars, generate: openssl rand -base64 48)
# Application will FAIL TO START if not set
JWT_SECRET=

# =============================================================================
# API Keys (REQUIRED - obtain from service providers)
# =============================================================================
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# =============================================================================
# DATABASE CREDENTIALS (REQUIRED - use strong passwords)
# =============================================================================
# PostgreSQL (generate: openssl rand -base64 18)
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=
POSTGRES_DB=knowledge
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Neo4j Graph Database (generate: openssl rand -base64 18)
NEO4J_AUTH=neo4j/CHANGE_ME_STRONG_PASSWORD
NEO4J_PORT=7687
NEO4J_BROWSER_PORT=7474
NEO4J_HOST=localhost

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server
API_HOST=0.0.0.0
API_PORT=8000
RELOAD=true

# =============================================================================
# BGE-M3 Embedding
# =============================================================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# =============================================================================
# LLM Models
# =============================================================================
EXTRACTION_MODEL=deepseek-chat
ORCHESTRATION_MODEL=gpt-4o
SYNTHESIS_MODEL=gpt-4o

# =============================================================================
# Cost Tracking
# =============================================================================
ENABLE_COST_TRACKING=true
COST_LOG_PATH=./hybrid-rag-knowledge-ops/results/cost_reports/

# =============================================================================
# Features
# =============================================================================
ENABLE_METADATA_EXTRACTION=true
ENABLE_GRAPH_TRAVERSAL=true
ENABLE_HYBRID_SEARCH=true
