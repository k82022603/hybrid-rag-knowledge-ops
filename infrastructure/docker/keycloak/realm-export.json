{
  "id": "hybrid-rag",
  "realm": "hybrid-rag",
  "displayName": "Hybrid RAG Knowledge Platform",
  "displayNameHtml": "<b>Hybrid RAG Knowledge Platform</b>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 3600,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role with full access to all resources",
        "composite": true,
        "composites": {
          "realm": ["user", "viewer"]
        }
      },
      {
        "name": "user",
        "description": "Standard user role with read/write access",
        "composite": true,
        "composites": {
          "realm": ["viewer"]
        }
      },
      {
        "name": "viewer",
        "description": "Read-only access role",
        "composite": false
      }
    ],
    "client": {
      "frontend": [
        {
          "name": "document:read",
          "description": "Can read documents"
        },
        {
          "name": "document:write",
          "description": "Can create and edit documents"
        },
        {
          "name": "document:delete",
          "description": "Can delete documents"
        },
        {
          "name": "search:execute",
          "description": "Can execute searches"
        },
        {
          "name": "admin:manage",
          "description": "Can manage system settings"
        }
      ],
      "backend": [
        {
          "name": "api:read",
          "description": "Can read via API"
        },
        {
          "name": "api:write",
          "description": "Can write via API"
        },
        {
          "name": "api:admin",
          "description": "Admin API access"
        }
      ],
      "ai-service": [
        {
          "name": "search:vector",
          "description": "Can perform vector search"
        },
        {
          "name": "search:graph",
          "description": "Can perform graph search"
        },
        {
          "name": "search:hybrid",
          "description": "Can perform hybrid search"
        },
        {
          "name": "model:inference",
          "description": "Can call LLM inference"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "Administrators",
      "path": "/Administrators",
      "realmRoles": ["admin"]
    },
    {
      "name": "Users",
      "path": "/Users",
      "realmRoles": ["user"]
    },
    {
      "name": "Viewers",
      "path": "/Viewers",
      "realmRoles": ["viewer"]
    }
  ],
  "defaultDefaultClientScopes": [
    "email",
    "profile",
    "roles",
    "web-origins"
  ],
  "clients": [
    {
      "clientId": "frontend",
      "name": "Knowledge Platform Frontend",
      "description": "React SPA Frontend Application (Public Client)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "${FRONTEND_URL:http://localhost}",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost/*",
        "http://localhost:3000/*",
        "http://localhost:80/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost",
        "http://localhost:3000",
        "http://localhost:80",
        "http://127.0.0.1",
        "http://127.0.0.1:3000"
      ],
      "defaultClientScopes": [
        "email",
        "profile",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/*##http://127.0.0.1/*"
      }
    },
    {
      "clientId": "backend",
      "name": "Knowledge Platform Backend",
      "description": "Spring Boot Backend Service (Confidential Client)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "secret": "${BACKEND_CLIENT_SECRET:backend-secret-dev}",
      "redirectUris": [
        "http://localhost:8081/*",
        "http://backend:8081/*"
      ],
      "webOrigins": [
        "http://localhost:8081",
        "http://backend:8081"
      ],
      "defaultClientScopes": [
        "email",
        "profile",
        "roles"
      ],
      "attributes": {
        "access.token.lifespan": "3600",
        "client.secret.creation.time": "1704067200"
      }
    },
    {
      "clientId": "ai-service",
      "name": "Knowledge Platform AI Service",
      "description": "FastAPI AI/ML Service (Confidential Client)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "secret": "${AI_SERVICE_CLIENT_SECRET:ai-service-secret-dev}",
      "redirectUris": [
        "http://localhost:8000/*",
        "http://ai-service:8000/*"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://ai-service:8000"
      ],
      "defaultClientScopes": [
        "email",
        "profile",
        "roles"
      ],
      "attributes": {
        "access.token.lifespan": "3600",
        "client.secret.creation.time": "1704067200",
        "service.accounts.enabled": "true"
      }
    },
    {
      "clientId": "knowledge-frontend",
      "name": "Knowledge Platform Frontend (Alias)",
      "description": "Alias for frontend client compatibility",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "${FRONTEND_URL:http://localhost}",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost/*",
        "http://localhost:3000/*",
        "http://localhost:80/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost",
        "http://localhost:3000",
        "http://localhost:80",
        "http://127.0.0.1",
        "http://127.0.0.1:3000"
      ],
      "defaultClientScopes": [
        "email",
        "profile",
        "roles",
        "web-origins"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "knowledge-backend",
      "name": "Knowledge Platform Backend (Alias)",
      "description": "Alias for backend client compatibility",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8081/*",
        "http://backend:8081/*"
      ],
      "webOrigins": [
        "http://localhost:8081",
        "http://backend:8081"
      ],
      "defaultClientScopes": [
        "email",
        "profile",
        "roles"
      ],
      "attributes": {
        "access.token.lifespan": "3600"
      }
    }
  ],
