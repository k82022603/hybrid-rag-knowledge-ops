# =============================================================================
# Hybrid RAG Knowledge Platform - Docker Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env file to version control!
# SECURITY GUIDE: knowledge_service/docs/06_deployment/security_env_setup_guide.md
# Generate secrets with: openssl rand -base64 48
# =============================================================================

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
COMPOSE_PROJECT_NAME=knowledge-platform
VERSION=latest
REGISTRY=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
SPRING_PROFILE=docker
LOG_LEVEL=INFO

# Domain Settings (for production)
DOMAIN=localhost
API_URL=http://localhost:8080/api
AUTH_URL=http://localhost:8180
WS_URL=ws://localhost:8080/ws

# =============================================================================
# PORT CONFIGURATION (Customize to avoid conflicts)
# =============================================================================
# Application Ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
GATEWAY_PORT=8080
KEYCLOAK_PORT=8180

# Database Ports
ELASTICSEARCH_PORT=9200
NEO4J_BROWSER_PORT=7474
NEO4J_BOLT_PORT=7687
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Monitoring Ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14268

# =============================================================================
# DATABASE CREDENTIALS (REQUIRED - Generate strong passwords)
# =============================================================================
# Main PostgreSQL Database (generate: openssl rand -base64 18)
DB_NAME=knowledge
DB_USERNAME=knowledge
DB_PASSWORD=

# Neo4j Graph Database (generate: openssl rand -base64 18)
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Redis Cache (optional, leave empty for no password)
REDIS_PASSWORD=

# =============================================================================
# KEYCLOAK (OAuth 2.0 / OIDC)
# =============================================================================
# Keycloak Admin Credentials (DO NOT use "admin/admin" in production)
# Generate password: openssl rand -base64 18
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# Keycloak Database (generate: openssl rand -base64 18)
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=

# Keycloak Settings
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_REALM=hybrid-rag

# =============================================================================
# SECURITY: JWT SECRET (REQUIRED - Application fails to start without this)
# =============================================================================
# Generate with: openssl rand -base64 48
# Must be at least 32 characters for HS256 signing
# DO NOT use default/placeholder values in production
JWT_SECRET=

# =============================================================================
# OBJECT STORAGE (MinIO) - Generate keys: openssl rand -base64 18
# =============================================================================
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents

# =============================================================================
# AI SERVICE (DeepSeek LLM)
# =============================================================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# =============================================================================
# MONITORING (Grafana) - DO NOT use "admin/admin" in production
# =============================================================================
# Generate password: openssl rand -base64 18
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_URL=http://localhost:3001

# =============================================================================
# RESOURCE LIMITS (Adjust based on available resources)
# =============================================================================
# Minimum recommended: 16GB RAM
# For development, you can reduce these values:
#
# AI_SERVICE_MEMORY_LIMIT=4G
# ELASTICSEARCH_MEMORY_LIMIT=2G
# POSTGRESQL_MEMORY_LIMIT=2G
# NEO4J_MEMORY_LIMIT=2G

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# Uncomment for local development with reduced resources:
#
# ES_JAVA_OPTS=-Xms1g -Xmx1g
# NEO4J_dbms_memory_heap_max__size=1G
# NEO4J_dbms_memory_pagecache_size=512M
