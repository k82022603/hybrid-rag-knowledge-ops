# =============================================================================
# Knowledge Service - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env file to version control!
# SECURITY GUIDE: docs/06_deployment/security_env_setup_guide.md
# =============================================================================

# =============================================================================
# SECURITY: JWT Secret (REQUIRED - Application fails to start without this)
# =============================================================================
# Generate with: openssl rand -base64 48
# Must be at least 32 characters for HS256 signing
JWT_SECRET_KEY=

# Token expiration settings (optional, defaults shown)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Application Settings
# =============================================================================
DEBUG=true
ENVIRONMENT=development

# =============================================================================
# AI Service API Keys (REQUIRED - obtain from service provider)
# =============================================================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# =============================================================================
# Database Credentials (REQUIRED - generate strong passwords)
# =============================================================================
# PostgreSQL (generate: openssl rand -base64 18)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=knowledge_db

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# Neo4j Graph Database (generate: openssl rand -base64 18)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# =============================================================================
# Authentication - Admin Account (REQUIRED for login)
# =============================================================================
# Generate password hash with:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your_password'))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_NAME=System Administrator

# =============================================================================
# Authentication - Test User Account (OPTIONAL)
# =============================================================================
# TEST_USER_EMAIL=test@example.com
# TEST_USER_PASSWORD_HASH=
# TEST_USER_NAME=Test User

# =============================================================================
# RAG Configuration
# =============================================================================
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MAX_GLEANINGS=1
RETRIEVAL_TOP_K=10
RRF_K=60

# =============================================================================
# RAGAS Quality Targets
# =============================================================================
RAGAS_FAITHFULNESS_TARGET=0.9
RAGAS_RELEVANCY_TARGET=0.85
RAGAS_PRECISION_TARGET=0.8
