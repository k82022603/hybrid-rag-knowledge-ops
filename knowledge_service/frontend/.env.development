# Development Environment Configuration

# API Configuration
# Auth server running on port 8002
VITE_API_BASE_URL=http://localhost:8002

# Enable mock authentication (bypass real backend)
VITE_USE_MOCK_AUTH=false

# Keycloak Configuration (SSO)
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=knowledge-platform
VITE_KEYCLOAK_CLIENT_ID=knowledge-frontend

# Application Settings
VITE_APP_NAME=Knowledge Portal
VITE_APP_VERSION=0.1.0
